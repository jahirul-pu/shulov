# ──────────────────────────────────────────────────
# Shulov Backend — Environment Variables
# ──────────────────────────────────────────────────

# JWT Secret (used for auth token signing)
JWT_SECRET=shulov-secret-key-2026

# ──────────────────────────────────────────────────
# SMS Provider Configuration
# ──────────────────────────────────────────────────
# Set SMS_PROVIDER to "console" for development logging (no real SMS sent).
# To use a real provider, set this to "twilio", "bulksmsbd", etc.
# and fill in the API key below.
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=Shulov

# ──────────────────────────────────────────────────
# Email Provider Configuration (SMTP / Nodemailer)
# ──────────────────────────────────────────────────
# Leave SMTP_HOST empty for development logging (no real email sent).
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587
# For Zoho: SMTP_HOST=smtp.zoho.com, SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@shulov.com
